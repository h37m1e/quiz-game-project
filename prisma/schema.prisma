generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Question {
  id       Int       @id @default(autoincrement())
  question  String  @db.VarChar(255)
  answer  String    @db.Text
  subject    String    @db.VarChar(255)
  keywords Keyword[]

  @@map("Questions")
}

model Keyword {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(100)
  question Question[]

  @@map("keywords")
}


